{
  "name": "receipt-suggest",
  "version": "2.0.0",
  "description": "Recipe suggestion application - Angular 22+ migration",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate:manifest && ng serve",
    "build": "ng build",
    "generate:manifest": "node scripts/generate-recipe-manifest.mjs",
    "recipe:new": "node scripts/new-recipe.mjs",
    "recipe:validate": "node scripts/validate-recipe-data.mjs",
    "build:prod": "npm run recipe:validate && npm run generate:manifest && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "jasmine-core": "~5.1.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "~6.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
